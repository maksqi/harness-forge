# harness-forge environment variables. Copy to .env and adjust; every variable is optional.
# Full reference: docs/DECISIONS.md (Contract seed) and docs/ARCHITECTURE.md.

# --- Server -----------------------------------------------------------------

# Port of the API server (also serves the built web app in production).
HF_PORT=8787

# Bind address. A non-loopback host requires HF_PASSWORD or HF_INSECURE=1.
HF_HOST=127.0.0.1

# Data directory (SQLite database, master key, plugins, uploads, caches).
# Relative paths are resolved against the repository root in development.
HF_DATA_DIR=./data

# Enables the login screen. Overrides a password stored in settings.
# HF_PASSWORD=

# Base64-encoded 32-byte master key for encrypting secrets.
# When unset, data/secret.key is generated on first start (file mode 0600).
# HF_MASTER_KEY=

# 1 = register the dev-only "mock" provider (used by tests and e2e).
# HF_MOCK_PROVIDER=1

# 1 = load builtin plugins only (recovery mode).
# HF_SAFE_MODE=1

# 1 = hot-reload code plugins when their files change.
# HF_PLUGIN_WATCH=1

# 1 = never download the models.dev catalog snapshot.
# HF_OFFLINE=1

# 1 = allow a non-loopback HF_HOST without HF_PASSWORD (not recommended).
# HF_INSECURE=1

# Trusted reverse proxies: a comma-separated list of `loopback` (127.0.0.0/8, ::1), `private` (10/8, 172.16/12,
# 192.168/16, fc00::/7), IP addresses and CIDRs, e.g. `loopback` for Caddy or nginx on this machine, `private` for a
# proxy container on a Docker network, or the proxy's exact address. Only these peers may set X-Forwarded-For and
# X-Forwarded-Proto (login rate limits per real client, Secure cookies); X-Forwarded-Host is never used, so the proxy
# must forward Host. `1`, `true` and hop counts are rejected. Unset = v1 behavior (X-Forwarded-For ignored).
# See README.md "Behind a reverse proxy".
# HF_TRUST_PROXY=loopback

# --- Web (development only) --------------------------------------------------

# Where `nuxt dev` proxies /api requests.
HF_API_TARGET=http://localhost:8787

# Directory of the built SPA served by the production server (default: apps/web/.output/public).
# HF_WEB_DIR=

# --- Provider key fallbacks ----------------------------------------------------
# Used when no key is stored in Settings -> Providers (shown there as "From env").

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# ALIBABA_API_KEY=
# ZAI_API_KEY=
# MINIMAX_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- Tests only ------------------------------------------------------------------
# Live provider suite (docs/PROVIDERS.md section 12): `pnpm test:live` makes PAID calls with the keys above.
# HF_LIVE=1 is set by `pnpm test:live` itself; `pnpm test` never runs the live suite.
# HF_LIVE_PROVIDERS=anthropic,openai
# HF_LIVE_MAX_COST_USD=0.50
# Other test-only variables (HF_TEST_REQUIRE_WEB_BUILD, E2E_SCREENSHOTS): docs/DECISIONS.md.
