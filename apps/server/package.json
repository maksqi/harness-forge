    "@ai-sdk/groq": "^4.0.54",
    "@ai-sdk/mcp": "^2.0.66",
    "@ai-sdk/minimax": "^3.0.48",
    "@ai-sdk/mistral": "^4.0.56",
    "@ai-sdk/moonshotai": "^3.0.62",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@ai-sdk/provider": "catalog:",
    "@ai-sdk/xai": "^5.0.14",
    "@ai-sdk/zai": "^3.0.24",
    "@harness-forge/plugin-sdk": "workspace:*",
    "@harness-forge/shared": "workspace:*",
    "@hono/node-server": "^2.1.3",
