{
  "name": "@harness-forge/server",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "harness-forge API server (Hono) that also serves the built web app.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
