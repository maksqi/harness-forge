  "devDependencies": {
    "@types/node": "catalog:",
    "@types/semver": "^7.7.0",
    "drizzle-kit": "^0.31.0",
    "tsdown": "^0.23.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
